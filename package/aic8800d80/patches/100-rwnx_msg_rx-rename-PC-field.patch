From: hillz2 <hillz2@users.noreply.github.com>
Subject: [PATCH] rwnx_msg_rx: rename fault_ctxt.PC so MIPS builds

arch/mips/include/uapi/asm/ptrace.h defines a bare `PC` macro (value 64,
the ptrace register index) and reaches the driver through
linux/interrupt.h. The preprocessor therefore rewrites every identifier
spelled `PC`, so `uint32_t PC;` becomes `uint32_t 64;` and the build dies
with:

  arch/mips/include/uapi/asm/ptrace.h:17:25: error: expected identifier
  or '(' before numeric constant

Rename the struct member and its single user. This is a pure rename: the
member's type and offset are unchanged, so struct fault_ctxt still matches
the fault context the firmware sends. The printed label stays "PC".

Only MIPS defines such a macro, but the new name is harmless everywhere.

--- a/drivers/aic8800/aic8800_fdrv/rwnx_msg_rx.c
+++ b/drivers/aic8800/aic8800_fdrv/rwnx_msg_rx.c
@@ -1596,7 +1596,7 @@ struct fault_ctxt {
     uint32_t reg_i[13];
     uint32_t SP;
     uint32_t LR;
-    uint32_t PC;
+    uint32_t pc_reg;
     uint32_t xPSR;
     uint32_t PSP;
     uint32_t MSP;
@@ -1626,7 +1626,7 @@ static inline int rwnx_fw_panic_ind(struct rwnx_hw *rwnx_hw,
         printk("REG %d = [%x]\n", i, fault.reg_i[i]);
     printk("SP = [%x]\n", fault.SP);
     printk("LR = [%x]\n", fault.LR);
-    printk("PC = [%x]\n", fault.PC);
+    printk("PC = [%x]\n", fault.pc_reg);
     printk("PSP = [%x]\n", fault.PSP);
     printk("xPSR = [%x]\n", fault.xPSR);
     printk("EXC_RETURN = [%x]\n", fault.EXC_RETURN);
